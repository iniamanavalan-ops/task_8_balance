import java.util.*;
import java.util.stream.Collectors;
class Employee {

    int id; String name, dept;
    Employee(int id, String name, String dept) { this.id = id; this.name = name; this.dept = dept; }
    public String toString() { return String.format("%-3d | %-12s | %-10s", id, name, dept); }
}

public class Main {
    static List<Employee> employees = Arrays.asList(
        new Employee(1, "Alice", "IT"), new Employee(2, "Bob", "HR"), new Employee(3, "Charlie", "IT"),
        new Employee(4, "Diana", "Sales"), new Employee(5, "Eve", "HR"), new Employee(6, "Frank", "IT"),
        new Employee(7, "Grace", "Sales"), new Employee(8, "Henry", "IT"), new Employee(9, "Ivy", "HR"),
        new Employee(10, "Jack", "Sales"), new Employee(11, "Kevin", "IT"), new Employee(12, "Lisa", "HR")
    );
        
    static List<Employee> sortedList = new ArrayList<>(employees);
    static int page = 1, pageSize = 4;
    static String sortBy = "id";
    static boolean asc = true;

    static void sort() {
        Comparator<Employee> comp = sortBy.equals("name") ? Comparator.comparing(e -> e.name) : Comparator.comparing(e -> e.dept);
        if (!asc) comp = comp.reversed();
    
        sortedList = employees.stream().sorted(comp).collect(Collectors.toList());
    }
    static void display() {
        sort();
        int start = (page - 1) * pageSize, end = Math.min(start + pageSize, sortedList.size());
    
        System.out.println("\n=== Employees (Page " + page + "/" + (int)Math.ceil(sortedList.size()/(double)pageSize) + 
                         ", Sort: " + sortBy + " " + (asc ? "↑" : "↓") + ") ===");
        System.out.println("ID  | Name         | Dept");
    
        for (int i = start; i < end; i++) System.out.println(sortedList.get(i));
        System.out.println("[P]rev [N]ext [S]ort Name [D]ept [R]eset [Q]uit");
    }

    public static void main(String[] args) {
        Scanner sc = new Scanner(System.in);

        while (true) {
            display();

            char cmd = sc.next().toLowerCase().charAt(0);
    
            if (cmd == 'n' && page * pageSize < sortedList.size()) page++;
            else if (cmd == 'p' && page > 1) page--;
            else if (cmd == 's') { sortBy = "name"; asc = true; page = 1; }
            else if (cmd == 'd') { sortBy = "dept"; asc = true; page = 1; }
            else if (cmd == 'r') { sortBy = "id"; asc = true; page = 1; sort(); }
            else if (cmd == 'q') break;
        }
        sc.close();
    
    }
}


